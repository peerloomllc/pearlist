{
  "expo": {
    "name": "PearList",
    "slug": "pearlist",
    "version": "1.1.18",
    "newArchEnabled": true,
    "orientation": "portrait",
    "scheme": ["pear", "pearlist"],
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.pearlist",
      "buildNumber": "9",
      "associatedDomains": [
        "applinks:peerloomllc.com"
      ],
      "infoPlist": {
        "NSCameraUsageDescription": "Used to scan space invite QR codes.",
        "NSLocalNetworkUsageDescription": "PearList connects directly to your peers' devices on your Wi-Fi to sync lists peer-to-peer.",
        "NSBonjourServices": [
          "_hyperswarm._udp",
          "_pearlistlan._tcp"
        ],
        "LSApplicationQueriesSchemes": [
          "lightning"
        ]
      }
    },
    "android": {
      "package": "com.pearlist",
      "versionCode": 1001018,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0d0d0d"
      },
      "permissions": [
        "CAMERA",
        "POST_NOTIFICATIONS",
        "USE_EXACT_ALARM",
        "ACCESS_NETWORK_STATE",
        "WAKE_LOCK"
      ],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": false,
          "data": [
            {
              "scheme": "pear",
              "host": "pearlist",
              "pathPrefix": "/join"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "peerloomllc.com",
              "pathPrefix": "/pearlist/join"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "SEND",
          "data": [
            {
              "mimeType": "text/plain"
            },
            {
              "mimeType": "image/*"
            }
          ],
          "category": [
            "DEFAULT"
          ]
        },
        {
          "action": "SEND_MULTIPLE",
          "data": [
            {
              "mimeType": "image/*"
            }
          ],
          "category": [
            "DEFAULT"
          ]
        }
      ]
    },
    "plugins": [
      "./plugins/with-ios-pod-deployment-target",
      "./plugins/with-ios-scene-lifecycle",
      "./plugins/with-ios-share-extension",
      [
        "expo-router"
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 29
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon.png",
          "imageWidth": 200,
          "backgroundColor": "#0d0d0d",
          "resizeMode": "contain"
        }
      ],
      "./plugins/with-android-abis",
      "./plugins/with-gradle-jvmargs",
      "./plugins/with-android-queries",
      "./plugins/with-android-debug-app-id",
      "./plugins/with-android-standalone-debug",
      "./plugins/with-android-release-signing",
      "./plugins/with-strip-aps",
      "./plugins/with-android-no-firebase",
      "./plugins/with-compressed-debug-libs",
      "expo-secure-store"
    ],
    "assets": [
      "./assets/bare-universal.bundle",
      "./assets/bare-ios.bundle"
    ]
  }
}
